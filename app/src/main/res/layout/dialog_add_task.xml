<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add New Task"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginBottom="20dp"/>

        <!-- Task Title -->
        <EditText
            android:id="@+id/etTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Title *"
            android:inputType="textCapSentences"
            android:background="@drawable/bg_dialog_input"
            android:textColor="?attr/colorOnSurfaceInverse"
            android:textColorHint="?attr/colorOnSurfaceInverse"
            android:layout_marginBottom="12dp"/>

        <!-- Task Subject -->
        <EditText
            android:id="@+id/etSubject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Subject"
            android:inputType="text"
            android:background="@drawable/bg_dialog_input"
            android:textColor="?attr/colorOnSurfaceInverse"
            android:textColorHint="?attr/colorOnSurfaceInverse"
            android:layout_marginBottom="12dp"/>

        <!-- Task Description -->
        <EditText
            android:id="@+id/etDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Description"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:gravity="top"
            android:background="@drawable/bg_dialog_input"
            android:textColor="?attr/colorOnSurfaceInverse"
            android:textColorHint="?attr/colorOnSurfaceInverse"
            android:layout_marginBottom="12dp"/>

        <!-- Task Due Date (FIXED TO OPEN CALENDAR) -->
        <EditText
            android:id="@+id/etDueDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Due Date *"
            android:inputType="none"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:clickable="true"
            android:cursorVisible="false"
            android:background="@drawable/bg_dialog_input"
            android:textColor="?attr/colorOnSurfaceInverse"
            android:textColorHint="?attr/colorOnSurfaceInverse"
            android:layout_marginBottom="12dp"/>

        <!-- Task Type -->
        <EditText
            android:id="@+id/etType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Type (e.g., ASSIGNMENT, QUIZ, PROJECT)"
            android:inputType="textCapCharacters"
            android:background="@drawable/bg_dialog_input"
            android:textColor="?attr/colorOnSurfaceInverse"
            android:textColorHint="?attr/colorOnSurfaceInverse"
            android:layout_marginBottom="12dp"/>

        <!-- Task Priority -->
        <EditText
            android:id="@+id/etPriority"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Priority (e.g., HIGH, MEDIUM, LOW)"
            android:inputType="textCapCharacters"
            android:background="@drawable/bg_dialog_input"
            android:textColor="?attr/colorOnSurfaceInverse"
            android:textColorHint="?attr/colorOnSurfaceInverse"
            android:layout_marginBottom="12dp"/>

    </LinearLayout>
</ScrollView>